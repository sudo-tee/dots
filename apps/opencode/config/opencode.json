{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
    },
    "autoshare": false,
    "autoupdate": false,
    "model": "github-copilot/gpt-5-mini",
    "agent": {
        "no-trust": {
            "model": "github-copilot/gpt-5-mini",
            "description": "Reads and understands code, answers questions, and provides explanations",
            "mode": "subagent",
            "prompt": "You are a code reader. Provide clear explanations and answer questions about the code.",
            "permission": {
                "bash": "ask",
                "edit": "ask"
            }
        },
        "plan": {}
    },
    "mcp": {
        "context7": {
            "enabled": false,
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ],
            "type": "local"
        },
        "chrome-devtools": {
            "enabled": false,
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "type": "local"
        }
    },
}

              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {

{
  "$schema": "https://opencode.ai/config.json",
  "permission": {},
  "autoupdate": false,
  "provider": {
    "databricks-gpt": {
      "npm": "@ai-sdk/openai",
      "name": "Databricks GPT",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:ANTHROPIC_AUTH_TOKEN}"

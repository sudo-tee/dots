{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoshare": false,
  "autoupdate": false,
  "agent": {
      "review": {
          "prompt": "{file:./prompts/review.txt}",
          "tools": {
              "grep": true,
              "bash": false,
              "read": true,
              "glob": true,
              "write": false,
              "edit": false
          }
      }
  },
  "mcp": {
      "context7": {
          "enabled": true,
          "command": [
              "npx",
              "-y",
              "@upstash/context7-mcp"
            ],
          "type": "local"
      }
  },
  "model": "github-copilot/claude-sonnet-4"
}

{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME",
      { "path": "{env:HOME}/.local/share/nvim/lazy/lazy.nvim", "ignoreGlobs": ["**/*_spec.lua"] },
      { "path": "{env:HOME}/.local/share/nvim/lazy/snacks.nvim", "ignoreGlobs": ["**/*_spec.lua"] }
    ],
    "ignoreGlobs": [
      "**/*_spec.lua"
    ]
  }
}

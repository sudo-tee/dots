# Don't let ripgrep vomit really long lines to my terminal, and show a preview.
--max-columns=150
--max-columns-preview

# Add my 'web' type.
--type-add
web:*.{html,css,js}*

# Search hidden files / directories (e.g. dotfiles) by default
--hidden

# Using glob patterns to include/exclude files or folders
--glob=!.git/*

# or
--glob
!.git/*

--glob
!tests/e2e/*

--glob
!pnpm-lock.yaml

--glob
!yarn.lock

--glob
!package-lock.json

--glob
!tests/e2e/**/*

--glob
!tsx-0/

--glob
!apps/docs/.vitepress

--glob
!apps/docs/

--glob
!apps/shell-app/assets

# Set the colors.
--colors=line:none
--colors=line:style:bold

# Because who cares about case!?
--smart-case
